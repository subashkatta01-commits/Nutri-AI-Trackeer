# Copy this file to `.env` and fill in the keys for the provider you want to use.
# `.env` is gitignored - never commit real API keys.

# Which AI provider handles meal analysis.
# Supported values: groq | gemini   (default: groq)
AI_PROVIDER=groq

# ---------- Groq (default provider) ----------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_ACTUAL_GROQ_API_KEY

# Must be a vision-capable model, otherwise photo analysis is impossible.
# List what your key can access: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=qwen/qwen3.8-27b

# ---------- Google Gemini (optional) ----------
# Only needed when AI_PROVIDER=gemini
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- App ----------
AUTH_SECRET=replace_with_a_random_string
PORT=3001
